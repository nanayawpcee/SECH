# Copy this file to .env.local and fill in the real values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored and must never be committed. Next.js only reads env
# files at startup, so restart the dev server after changing them.


# ── Required ────────────────────────────────────────────────────────────────

# Shared secret gating public booking submissions.
#
# Patients have no WordPress account, so POST /api/bookings is unauthenticated
# and instead sends this value as the X-SECH-BOOKING-KEY header. It must match
# byte-for-byte the secret the WordPress booking plugin checks against.
#
# If this is unset, every booking is rejected with a 503 and patients are told
# to phone the hospital — the form itself gives no other clue that it is
# misconfigured, so check the server log for:
#
#   SECH_BOOKING_KEY is not set — booking submissions cannot be saved.
#
# Get the value from the wordpress-plugin/ source or from the deployment's
# environment variables. Never expose it to the browser.
SECH_BOOKING_KEY=


# ── PostHog ─────────────────────────────────────────────────────────────────
# Public browser project token and ingestion host.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ── Optional ────────────────────────────────────────────────────────────────

# WPGraphQL endpoint backing bookings, admin auth and the news pages.
# Defaults to https://sech-gh.org/graphql when unset; override to point a local
# or staging build at a different WordPress install.
WP_GRAPHQL_ENDPOINT=https://sech-gh.org/graphql
